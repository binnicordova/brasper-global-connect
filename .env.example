VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Lovable may instead provide VITE_SUPABASE_PUBLISHABLE_KEY (public browser key).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend secrets go in Supabase Edge Function secrets, NEVER in VITE_*.

# The site talks to the BRASPER Cloud Functions with the public Firebase web config already in
# src/lib/api/config.ts. Override only for another project or the local emulators.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_EMULATOR_HOST=localhost
