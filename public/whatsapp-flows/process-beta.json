                  "payload": {
                    "attention": "${data.attention}",
                    "route": "${form.route}",
                    "amount": "${form.amount}",
                    "billing_type": "${form.billing_type}"
                  }
                }
              }
            ],
            "init-values": {
              "route": "PEN_BRL",
              "amount": "300",
              "billing_type": "boleta"
            }
          }
        ]
      }
    },
