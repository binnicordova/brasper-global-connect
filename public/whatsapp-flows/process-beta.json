{
  "version": "7.3",
  "screens": [
    {
      "id": "START",
      "title": "Asistente Brasper",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Hola, soy tu asistente Brasper."
              },
              {
                "type": "TextBody",
                "text": "Te acompaño para completar tu cambio. Esta es una demo: usa únicamente datos de ejemplo."
              },
              {
                "type": "Dropdown",
                "name": "attention",
                "label": "¿Cómo prefieres continuar?",
                "required": true,
                "data-source": [
                  {
                    "id": "ai",
                    "title": "Con el asistente Brasper"
                  },
                  {
                    "id": "human",
                    "title": "Con una persona (demo)"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Empezar mi cambio",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "REQUEST"
                  },
                  "payload": {
                    "attention": "${form.attention}"
                  }
                }
              }
            ],
            "init-values": {
              "attention": "ai"
            }
          }
        ]
      }
    },
    {
      "id": "REQUEST",
      "title": "Cotización",
      "data": {
        "attention": {
          "type": "string",
          "__example__": "ai"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextBody",
                "text": "Elige las monedas y el monto. En la web verás la tasa vigente y la comisión antes de aceptar. Aquí probamos el recorrido con opciones ficticias."
              },
              {
                "type": "Dropdown",
                "name": "route",
                "label": "Monedas que vas a cambiar",
                "required": true,
                "data-source": [
                  {
                    "id": "PEN_BRL",
                    "title": "Ejemplo PEN a BRL"
                  },
                  {
                    "id": "BRL_PEN",
                    "title": "Ejemplo BRL a PEN"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "amount",
                "label": "Monto que entregas",
                "required": true,
                "data-source": [
                  {
                    "id": "200",
                    "title": "200 (dato ficticio)"
                  },
                  {
                    "id": "300",
                    "title": "300 (dato ficticio)"
                  },
                  {
                    "id": "500",
                    "title": "500 (dato ficticio)"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "billing_type",
                "label": "Tu comprobante",
                "required": true,
                "data-source": [
                  {
                    "id": "boleta",
                    "title": "Boleta ficticia"
                  },
                  {
                    "id": "factura",
                    "title": "Factura ficticia"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Completar mis datos",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "CONTACT"
