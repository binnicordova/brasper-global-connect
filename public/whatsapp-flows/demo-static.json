{
  "version": "7.3",
  "screens": [
    {
      "id": "START",
      "title": "Brasper demo",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Prueba privada de pantallas"
              },
              {
                "type": "TextBody",
                "text": "Usa solo opciones de ejemplo. No se registran pagos ni operaciones reales."
              },
              {
                "type": "Dropdown",
                "name": "attention",
                "label": "Atención de prueba",
                "required": true,
                "data-source": [
                  {
                    "id": "ai",
                    "title": "Asistente IA demo"
                  },
                  {
                    "id": "human",
                    "title": "Asesor humano demo"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "REQUEST"
                  },
                  "payload": {
                    "attention": "${form.attention}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REQUEST",
      "title": "Solicitud demo",
      "data": {
        "attention": {
          "type": "string",
          "__example__": "ai"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextBody",
                "text": "Escenario demo. No muestra una cotización ni solicita depósito."
              },
              {
                "type": "Dropdown",
                "name": "route",
                "label": "Escenario demo",
                "required": true,
                "data-source": [
                  {
                    "id": "PEN_BRL",
                    "title": "Ejemplo PEN a BRL"
                  },
                  {
                    "id": "BRL_PEN",
                    "title": "Ejemplo BRL a PEN"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "amount",
                "label": "Importe de ejemplo",
                "required": true,
                "data-source": [
                  {
                    "id": "200",
                    "title": "200 (demo)"
                  },
                  {
                    "id": "300",
                    "title": "300 (demo)"
                  },
                  {
                    "id": "500",
                    "title": "500 (demo)"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "billing_type",
                "label": "Comprobante demo",
                "required": true,
                "data-source": [
                  {
                    "id": "boleta",
                    "title": "Boleta demo"
                  },
                  {
                    "id": "factura",
                    "title": "Factura demo"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Revisar",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "SUMMARY"
                  },
                  "payload": {
                    "attention": "${data.attention}",
                    "route": "${form.route}",
                    "amount": "${form.amount}",
                    "billing_type": "${form.billing_type}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "Resumen demo",
      "data": {
        "attention": {
          "type": "string",
          "__example__": "ai"
        },
        "route": {
          "type": "string",
          "__example__": "PEN_BRL"
        },
        "amount": {
          "type": "string",
          "__example__": "300"
        },
        "billing_type": {
          "type": "string",
          "__example__": "boleta"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "Modalidad elegida"
              },
              {
                "type": "TextBody",
                "text": "${data.attention}"
              },
              {
                "type": "TextSubheading",
                "text": "Escenario"
              },
              {
                "type": "TextBody",
                "text": "${data.route}"
              },
              {
                "type": "TextSubheading",
                "text": "Importe demo"
              },
              {
                "type": "TextBody",
                "text": "${data.amount}"
              },
              {
                "type": "TextSubheading",
                "text": "Tipo de comprobante"
              },
              {
                "type": "TextBody",
                "text": "${data.billing_type}"
              },
              {
                "type": "TextCaption",
                "text": "Correo ilustrativo: demo@example.test. Finalizar solo devuelve los datos del ensayo; no asigna asesor ni genera PDF o correo."
              },
              {
                "type": "Footer",
                "label": "Finalizar prueba",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "attention": "${data.attention}",
                    "route": "${data.route}",
                    "amount": "${data.amount}",
                    "billing_type": "${data.billing_type}",
                    "demo": true
                  }
                }
              }
            ]
          }
        ]
      },
      "terminal": true
    }
  ]
}
